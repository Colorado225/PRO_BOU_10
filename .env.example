# Copier ce fichier vers .env et renseigner les valeurs réelles.
# NE JAMAIS COMMITTER LE FICHIER .env CONTENANT DE VRAIS SECRETS.

# --- Base de données ---
# Obligatoire en production (fail-fast au démarrage sinon).
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# --- Authentification (jose) ---
# Secret long et aléatoire (>= 32 caractères). Obligatoire en production.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Webhooks Mobile Money (signatures) ---
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_WEBHOOK_SECRET=
MTN_MOMO_WEBHOOK_SECRET=

# --- Front (Vite) ---
# Mode démo front : auto-login sans backend. Désactivé par défaut ;
# N'A PAS EFFET en build de production (import.meta.env.DEV requis).
VITE_DEMO_MODE=false
