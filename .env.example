# ==============================================================================
# Configuration Environnement — BoulangeriePro ERP (Clerk + Neon)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données Neon (PostgreSQL Serverless)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-xyz-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Authentification Clerk
# ------------------------------------------------------------------------------
# Clé publique pour l'application client React (Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# Clé secrète pour le backend Express
CLERK_SECRET_KEY=sk_test_...
# Secret du Webhook Clerk (Svix) pour la synchronisation des utilisateurs
CLERK_WEBHOOK_SECRET=whsec_...

# ------------------------------------------------------------------------------
# 3. Serveur API & Sécurité locale (Fallback)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 4. Webhooks & Intégrations Mobile Money (Côte d'Ivoire)
# ------------------------------------------------------------------------------
WAVE_WEBHOOK_SECRET=dev-wave-webhook-secret
ORANGE_MONEY_WEBHOOK_SECRET=dev-om-webhook-secret
MTN_MOMO_WEBHOOK_SECRET=dev-mtn-webhook-secret

# Clés API sandbox Mobile Money (Optionnel en mode simulation)
VITE_WAVE_API_KEY=
VITE_OM_API_KEY=
VITE_MTN_API_KEY=
